{
  "name": "@dldc/sync",
  "version": "1.10.1",
  "description": "Sync a single file between a server and multiple clients (rsync over HTTP + OPFS)",
  "keywords": [],
  "homepage": "https://github.com/dldc-packages/sync#readme",
  "bugs": {
    "url": "https://github.com/dldc-packages/sync/issues"
  },
  "license": "MIT",
  "author": "Etienne Dldc <e.deladonchamps@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dldc-packages/sync.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./client": {
      "types": "./dist/client.d.mts",
      "default": "./dist/client.mjs"
    },
    "./client/internal": {
      "types": "./dist/client/internal.d.mts",
      "default": "./dist/client/internal.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "default": "./dist/server.mjs"
    },
    "./server/internal": {
      "types": "./dist/server/internal.d.mts",
      "default": "./dist/server/internal.mjs"
    },
    "./shared": {
      "types": "./dist/shared.d.mts",
      "default": "./dist/shared.mjs"
    },
    "./shared/internal": {
      "types": "./dist/shared/internal.d.mts",
      "default": "./dist/shared/internal.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "test": "vp test run",
    "test:run": "vp test run",
    "test:watch": "vp test",
    "test:coverage": "vp test run --coverage",
    "check": "vp check",
    "lint": "vp lint",
    "format": "vp fmt",
    "pack": "vp pack",
    "example:todo": "tsx examples/todo/server.ts",
    "example:todo:client": "vite --config examples/todo/vite.config.ts",
    "example:todo:build": "vite build --config examples/todo/vite.config.ts",
    "example:todo:e2e": "vite build --config examples/todo/vite.config.ts && vitest run --config examples/todo/vite.e2e.config.ts",
    "example:optimistic": "tsx examples/optimistic/server.ts",
    "example:optimistic:client": "vite --config examples/optimistic/vite.config.ts",
    "example:optimistic:build": "vite build --config examples/optimistic/vite.config.ts",
    "example:optimistic:e2e": "vite build --config examples/optimistic/vite.config.ts && vitest run --config examples/optimistic/vite.e2e.config.ts",
    "release:check": "vp check && vp test run && vp pack",
    "release": "bumpp --execute \"npm run release:check\""
  },
  "dependencies": {
    "@dldc/librsync": "^2.0.3",
    "@dldc/pubsub": "^7.1.1",
    "@dldc/zendb": "^12.2.2",
    "@dldc/zendb-better-sqlite3": "^9.0.1",
    "@msgpack/msgpack": "^3.1.3",
    "better-sqlite3": "^13.0.3",
    "temporal-polyfill": "^1.0.5",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "bumpp": "^12.3.0",
    "playwright": "^1.40.0",
    "temporal-spec": "^1.0.1",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vite-plus": "^1.1.0",
    "vitest": "^5.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": "26.11.1",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
