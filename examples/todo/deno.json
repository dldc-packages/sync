{
  "tasks": {
    "dev": {
      "dependencies": ["client:dev", "server:dev"]
    },
    "client:dev": "vite",
    "server:dev": "deno run -A --unstable-ffi --unstable-no-legacy-abort --watch ./server.ts"
  },
  "nodeModulesDir": "auto",
  "unstable": ["ffi"],
  "imports": {
    "@db/sqlite": "jsr:@db/sqlite@^0.13.0",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^2.0.3",
    "@dldc/librsync": "jsr:@dldc/librsync@^2.0.2",
    "@dldc/pubsub": "jsr:@dldc/pubsub@^7.1.0",
    "@dldc/zendb": "jsr:@dldc/zendb@^12.2.0",
    "@dldc/zendb-db-sqlite": "jsr:@dldc/zendb-db-sqlite@^5.1.0",
    "@std/msgpack": "jsr:@std/msgpack@^1.0.3",
    "@valibot/valibot": "jsr:@valibot/valibot@^1.4.2",
    "vite": "npm:vite@^8.1.5"
  },
  "compilerOptions": {
    "lib": ["dom", "deno.ns", "webworker"]
  }
}
