{
  "name": "@dldc/sync",
  "version": "1.4.0",
  "exports": {
    "./client": "./src/client.ts",
    "./server": "./src/server.ts",
    "./shared": "./src/shared.ts"
  },
  "imports": {
    "@db/sqlite": "jsr:@db/sqlite@^0.13.0",
    "@dldc/librsync": "jsr:@dldc/librsync@^2.0.2",
    "@dldc/pubsub": "jsr:@dldc/pubsub@^7.1.0",
    "@dldc/zendb": "jsr:@dldc/zendb@^12.2.0",
    "@dldc/zendb-db-sqlite": "jsr:@dldc/zendb-db-sqlite@^5.1.0",
    "@dldc/zenjson": "jsr:@dldc/zenjson@^3.0.1",
    "@std/msgpack": "jsr:@std/msgpack@^1.0.3",
    "@std/expect": "jsr:@std/expect@^1.0.13",
    "@valibot/valibot": "jsr:@valibot/valibot@^1.4.2"
  },
  "tasks": {
    "test:run": "deno test -A",
    "test:watch": "deno test --watch",
    "bump": "deno run -A jsr:@mys/bump@1",
    "deps:outdated": "deno outdated",
    "deps:update": "deno outdated --update --latest --interactive",
    "check": "deno fmt --check . && deno lint . && deno check **/*.ts && deno task test:run",
    "test:coverage": "deno test -A --coverage=coverage && deno coverage coverage --html"
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "deno.unstable",
      "webworker",
      "dom"
    ]
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-explicit-any"
      ]
    }
  }
}
